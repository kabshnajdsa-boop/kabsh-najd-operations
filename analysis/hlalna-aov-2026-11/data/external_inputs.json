 "definitions": [
  {
   "item": "المؤشر الأساسي",
   "definition": "AOV = مجموع total.amount للطلبات المؤهلة ÷ عدد الطلبات الفريدة المؤهلة (ليس متوسط المتوسطات اليومية)"
  },
  {
   "item": "قيمة الطلب",
   "definition": "المبلغ النهائي في سلة (منتجات بعد الخصم + الشحن + رسوم الدفع عند الاستلام + ضريبة 15%)"
  },
  {
   "item": "الحالات المشمولة",
   "definition": "تم التوصيل، تم التنفيذ، جاري التوصيل، قيد التنفيذ، بانتظار المراجعة"
  },
  {
   "item": "المستبعد",
   "definition": "ملغي (يُحلَّل منفصلاً)، محذوف، بانتظار الدفع، طلب عرض سعر، مسترجع (1 طلب)، الطلبات بقيمة 0 من لوحة التحكم (6 طلبات، تُعامل كداخلية/تجريبية)"
  },
  {
   "item": "الدفع عند الاستلام",
   "definition": "مشمول إذا لم يُلغَ؛ يُعتمد total وليس المبلغ المدفوع لأن COD يُحصَّل عند التسليم"
  },
  {
   "item": "الخصومات",
   "definition": "مطروحة داخل total؛ إجمالي الخصم في L7 ≈ 835 ريال (0.7% من المبيعات) وفق تقرير مصادر الخصم"
  },
  {
   "item": "الاسترداد",
   "definition": "refund_amount = 0 لجميع الطلبات المؤهلة في النافذة؛ طلب مسترجع واحد مستبعد"
  },
  {
   "item": "المنطقة الزمنية",
   "definition": "Asia/Riyadh كما تعيدها سلة؛ اليوم الجاري 9 نوفمبر مستبعد"
  },
  {
   "item": "الفئة الرئيسية للطلب",
   "definition": "الفئة ذات أعلى قيمة تقديرية (الكمية × سعر الكتالوج الحالي) داخل الطلب — تصنيف غير متداخل"
  },
  {
   "item": "عميل عائد",
   "definition": "له طلب مؤهل سابق داخل نافذة 60 يوماً أو حسابه أُنشئ قبل الطلب بأكثر من يومين (تقريب: لا يوجد سجل طلبات قبل 10 سبتمبر)"
  },
  {
   "item": "الوزن",
   "definition": "تقديري = الكمية × وزن المنتج في الكتالوج؛ يُستبعد ما وزنه ≤0.2 كجم (ذبائح مسجلة بوزن 0.1 غير حقيقي)"
  },
  {
   "item": "التفكيك",
   "definition": "Shift-share متماثل: أثر المزيج = Δحصة × (متوسط الفئة − المتوسط العام)؛ الأثر الداخلي = متوسط الحصة × Δمتوسط الفئة؛ المجموع = ΔAOV بالضبط"
  }
 ],
